# --- Container registry: an attack agent proving it can write (plain HTTP registries, usually port 5000) ---
alert http any any -> $HTTP_SERVERS any (msg:"TD Container registry push to a repository named after an attack agent"; flow:established,to_server; http.method; content:"PUT"; http.uri; content:"/v2/"; startswith; content:"/manifests/"; fast_pattern; pcre:"/^\/v2\/(?:[^\/]+\/)*(?:artex[-_](?:i\d|probe|push|poc|rce|test|exploit|retest)|ptx-i\d|hermes-(?:h\d|writecheck)|csai-|cyberstrike-probe|xalgorix-|gh0st[-\/]|fsociety\/)/i"; classtype:web-application-attack; sid:3801041; rev:1; metadata:created_at 2026_11_23, confidence Medium, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1525, mitre_technique_name Implant_Internal_Image;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Container registry push with a write-test repository name"; flow:established,to_server; http.method; content:"PUT"; http.uri; content:"/v2/"; startswith; content:"/manifests/"; fast_pattern; pcre:"/^\/v2\/.*(?:writecheck|write-check|push-probe|push-poc|push-test|pwned|hijack-canary|regscan-probe|probe-write-test).*\/manifests\//i"; classtype:web-application-attack; sid:3801042; rev:1; metadata:created_at 2026_11_23, confidence Medium, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1525, mitre_technique_name Implant_Internal_Image;)
# Operators put nginx Basic auth in front of agent consoles and name the realm after the tool (exposure/README.md).
# ARTEX has its own rule (3800042). The realm is set by the web server in front of the console, so a match is probable.
alert http any any -> any any (msg:"TD Basic auth realm naming an agentic attack framework"; flow:established,to_client; http.stat_code; content:"401"; http.header; content:"realm=|22|"; nocase; fast_pattern; pcre:"/realm=\x22(?:cairn|pentagi|cyberstrikeai|cyberstrike|hexstrike|redamon|decepticon|open-kritt|kritt|t3mp3st|pojun|antifox)[\x22 ]/i"; classtype:policy-violation; sid:3801043; rev:1; metadata:created_at 2026_11_25, confidence Low, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
