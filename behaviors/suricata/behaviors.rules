# Agentic attack detections by ThreatDefence: behaviors shared by agentic attack frameworks
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. Rules keep the SIDs they were first published with.

alert http any any -> $HTTP_SERVERS any (msg:"TD Claude Code WebFetch user agent (AI agent page reader, Cairn workers, also legitimate use)"; flow:established,to_server; http.user_agent; content:"Claude-User (claude-code/"; fast_pattern; classtype:misc-activity; sid:3801010; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family Cairn, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Qwen Code user agent (AI agent page reader or search, also legitimate use)"; flow:established,to_server; http.user_agent; content:"QwenCode/"; startswith; fast_pattern; classtype:misc-activity; sid:3801012; rev:1; metadata:created_at 2026_11_21, confidence Low, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Kimi CLI user agent (AI agent page reader or search, also legitimate use)"; flow:established,to_server; http.user_agent; content:"KimiCLI/"; startswith; fast_pattern; classtype:misc-activity; sid:3801013; rev:1; metadata:created_at 2026_11_21, confidence Low, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)
alert http any any -> $HTTP_SERVERS any (msg:"TD opencode user agent (AI agent page reader or search, also legitimate use)"; flow:established,to_server; http.user_agent; content:"opencode/"; startswith; fast_pattern; classtype:misc-activity; sid:3801014; rev:1; metadata:created_at 2026_11_21, confidence Low, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Kali ffuf v2.1.0-dev user agent"; flow:established,to_server; http.user_agent; content:"Fuzz Faster U Fool v2.1.0-dev"; fast_pattern; classtype:web-application-attack; sid:3801011; rev:1; metadata:created_at 2026_11_21, confidence Low, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.003, mitre_technique_name Wordlist_Scanning;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"TD WSUS admin or sync web service requested from external address"; flow:established,to_server; http.uri; content:".asmx"; nocase; fast_pattern; pcre:"/\/(ApiRemoting30\/WebService|ServerSyncWebService\/ServerSyncWebService|ReportingWebService\/ReportingWebService)\.asmx/i"; classtype:attempted-admin; sid:3801040; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_22, confidence Medium, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
# One alert per source per hour. Burp Suite polls polling.oastify.com and polling.burpcollaborator.net for results: that is the tester's own client, not a payload firing, so those two exact names are left out. A payload name with a polling. label in front still alerts.
alert dns $HOME_NET any -> any any (msg:"TD Out-of-band testing domain lookup (oast.fun)"; dns.query; content:".oast.fun"; nocase; endswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 3600; classtype:web-application-attack; sid:3801050; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_22, confidence Medium, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert dns $HOME_NET any -> any any (msg:"TD Out-of-band testing domain lookup (oast.pro)"; dns.query; content:".oast.pro"; nocase; endswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 3600; classtype:web-application-attack; sid:3801051; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_22, confidence Medium, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
