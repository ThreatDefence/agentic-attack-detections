# Agentic attack detections by ThreatDefence: PentAGI
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3802001-3802499. Indicator-based IP rules live in pentagi-ip.rules (generated).
# DNS and TLS SNI rules work on encrypted traffic. The certificate rules see the certificate only in a TLS 1.2 handshake,
# because TLS 1.3 encrypts it. HTTP rules need cleartext or decrypted traffic.

# --- PentAGI console certificate and update service ---
alert tls any any -> any any (msg:"TD PentAGI console self-signed certificate (PentAGI CA)"; flow:established,to_client; tls.cert_issuer; content:"CN=PentAGI CA"; fast_pattern; classtype:policy-violation; sid:3802001; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.003, mitre_technique_name Digital_Certificates;)
alert tls any any -> any any (msg:"TD PentAGI console certificate subject O=PentAGI"; flow:established,to_client; tls.cert_subject; content:"O=PentAGI"; fast_pattern; classtype:policy-violation; sid:3802002; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.003, mitre_technique_name Digital_Certificates;)
alert dns $HOME_NET any -> any any (msg:"TD PentAGI update service lookup"; dns.query; content:"update.pentagi.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3802003; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert tls $HOME_NET any -> any any (msg:"TD PentAGI update service in TLS SNI"; tls.sni; content:"update.pentagi.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3802004; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- PentAGI console pages and API (cleartext or decrypted) ---
alert http any any -> any any (msg:"TD PentAGI Swagger UI served"; flow:established,to_client; http.response_body; content:"PentAGI Swagger API"; fast_pattern; classtype:policy-violation; sid:3802010; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD PentAGI console page title"; flow:established,to_client; http.response_body; content:"<title>PentAGI</title>"; fast_pattern; classtype:policy-violation; sid:3802011; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD PentAGI update check request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/v1/proxy/updates/pentagi/check"; fast_pattern; classtype:policy-violation; sid:3802012; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- PentAGI prompts inside model requests (AI gateways, TLS-inspecting proxies) ---
alert http $HOME_NET any -> any any (msg:"TD PentAGI pre-authorization prompt in model request"; flow:established,to_server; http.request_body; content:"operating within a fully authorized penetration testing system"; fast_pattern; classtype:policy-violation; sid:3802020; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family PentAGI, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1699, mitre_technique_name Direct_Prompt_Injection;)
alert http $HOME_NET any -> any any (msg:"TD PentAGI reflector prompt in model request"; flow:established,to_server; http.request_body; content:"TOOL CALL WORKFLOW ENFORCER"; fast_pattern; classtype:policy-violation; sid:3802021; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family PentAGI, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)

# --- Callbacks from your network to PentAGI worker ports (reverse shells, out-of-band) ---
alert tcp $HOME_NET any -> $EXTERNAL_NET 28000:29999 (msg:"TD Outbound connection to PentAGI worker port range 28000-29999"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; classtype:misc-activity; sid:3802030; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family PentAGI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1571, mitre_technique_name Non-Standard_Port;)
