# Agentic attack detections by ThreatDefence: Xalgorix
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3809001-3809499. HTTP rules need cleartext HTTP or decrypted traffic.
# The console (9137) and the callback listener are plain HTTP, so their rules work without decryption.

# --- Requests that reach your targets ---
alert http any any -> $HTTP_SERVERS any (msg:"TD Xalgorix verifier path marker"; flow:established,to_server; http.uri.raw; content:"xalgorix-"; fast_pattern; pcre:"/xalgorix-(?:nonexistent|missing)-[0-9a-z]+/"; classtype:web-application-attack; sid:3809001; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family Xalgorix, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Xalgorix XXE verifier marker"; flow:established,to_server; http.request_body; content:"xalgorix-xxe-"; fast_pattern; classtype:web-application-attack; sid:3809002; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family Xalgorix, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Xalgorix reflection canary in URI"; flow:established,to_server; http.uri; content:"XALG0R1XTEST"; fast_pattern; classtype:web-application-attack; sid:3809003; rev:1; metadata:created_at 2026_11_23, confidence Medium, malware_family Xalgorix, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Xalgorix reflection canary in request body"; flow:established,to_server; http.request_body; content:"XALG0R1XTEST"; fast_pattern; classtype:web-application-attack; sid:3809004; rev:1; metadata:created_at 2026_11_23, confidence Medium, malware_family Xalgorix, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
