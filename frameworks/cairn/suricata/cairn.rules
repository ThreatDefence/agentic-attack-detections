# Agentic attack detections by ThreatDefence: Cairn
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3801001-3801199. Indicator-based IP rules live in cairn-ip.rules (generated).
# HTTP rules need cleartext HTTP or TLS decryption. TLS SNI and DNS rules work on encrypted traffic.

# --- An exposed Cairn server (unauthenticated, port 8000 by default): scan or internal-sensor fingerprint ---
alert http any any -> any any (msg:"TD Cairn server OpenAPI description in response"; flow:established,to_client; http.response_body; content:"Fact-graph based collaborative exploration protocol"; fast_pattern; classtype:policy-violation; sid:3801001; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Cairn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Cairn server project list in response"; flow:established,to_client; http.response_body; content:"|22|unclaimed_intent_count|22|"; fast_pattern; content:"|22|working_intent_count|22|"; content:"|22|bootstrap_enabled|22|"; classtype:policy-violation; sid:3801002; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_22, confidence High, malware_family Cairn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Cairn dispatcher intent heartbeat"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/projects/"; content:"/intents/"; distance:0; content:"/heartbeat"; distance:0; endswith; classtype:policy-violation; sid:3801003; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family Cairn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Cairn task prompts inside cleartext or decrypted model requests (AI gateways, TLS-inspecting proxies) ---
alert http $HOME_NET any -> any any (msg:"TD Cairn anti-refusal task prompt in model request"; flow:established,to_server; http.request_body; content:"under no circumstances should you reject"; fast_pattern; content:"policy_refusal"; classtype:policy-violation; sid:3801020; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Cairn, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1699, mitre_technique_name Direct_Prompt_Injection;)
alert http $HOME_NET any -> any any (msg:"TD Cairn conclude-phase prompt in model request"; flow:established,to_server; http.request_body; content:"This is the conclude phase"; fast_pattern; content:"Current Intent"; classtype:policy-violation; sid:3801021; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Cairn, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)

