# The WSUS rule (SID 3801040) moved to behaviors/suricata/behaviors.rules.
# A Cairn build seen in Shodan on November 25, 2026 (title 衍迹 · 自主探索工作台, Cairn's Chinese name) serves a
# self-signed certificate with this subject. Not in the public code at 8e7e0ea.
alert tls any any -> any any (msg:"TD Cairn console auto-generated certificate"; flow:established,to_client; tls.cert_subject; content:"CN=Cairn auto-generated TLS certificate"; fast_pattern; classtype:policy-violation; sid:3801004; rev:1; metadata:created_at 2026_11_25, confidence High, malware_family Cairn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
