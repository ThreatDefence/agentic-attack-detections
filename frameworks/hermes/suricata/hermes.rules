# Agentic attack detections by ThreatDefence: Hermes Agent
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3806001-3806499. The Docker API on 2375 is plain HTTP.

# --- Carbonato: Docker API abuse that installs Hermes on the host ---
alert http any any -> $HOME_NET 2375 (msg:"TD Carbonato privileged host-mount container created through the Docker API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/containers/create"; fast_pattern; http.request_body; content:"\"Privileged\""; nocase; pcre:"/\"Privileged\"\s*:\s*true/i"; content:"/:/host"; classtype:attempted-admin; sid:3806001; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_22, confidence High, malware_family Carbonato;)
alert http any any -> any 2375 (msg:"TD Carbonato container name netns-probe or net-setup"; flow:established,to_server; http.uri; content:"/containers/create?name="; fast_pattern; pcre:"/name=(netns-probe|net-setup)/U"; classtype:attempted-admin; sid:3806002; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Carbonato;)
alert http any any -> any 2375 (msg:"TD Carbonato worm pulls system/resolved"; flow:established,to_server; http.uri; content:"/images/create?fromImage=system/resolved"; fast_pattern; classtype:trojan-activity; sid:3806003; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Carbonato;)
alert http any any -> any 2375 (msg:"TD Docker API exec into host namespaces with nsenter"; flow:established,to_server; http.uri; content:"/exec"; http.request_body; content:"nsenter"; fast_pattern; pcre:"/nsenter(\x22\s*,\s*\x22|\s+)(-t|--target)(\x22\s*,\s*\x22|\s+|=)1\b/"; classtype:attempted-admin; sid:3806004; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_22, confidence Medium, malware_family Carbonato;)

# --- Hermes consoles ---
alert http any any -> any any (msg:"TD Hermes WebUI server header"; flow:established,to_client; http.server; content:"HermesWebUI"; fast_pattern; classtype:policy-violation; sid:3806010; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family Hermes;)
alert http any any -> any any (msg:"TD Hermes Agent dashboard page"; flow:established,to_client; http.response_body; content:"<title>Hermes Agent - Dashboard</title>"; fast_pattern; classtype:policy-violation; sid:3806011; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family Hermes;)
# The sign-in page carries the same product name as the dashboard and is on far more hosts (exposure/consoles.csv).
alert http any any -> any any (msg:"TD Hermes Agent sign-in page"; flow:established,to_client; http.response_body; content:"Sign in |e2 80 94| Hermes Agent"; fast_pattern; classtype:policy-violation; sid:3806013; rev:1; metadata:created_at 2026_11_22, confidence Medium, malware_family Hermes;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Hermes results folder requested from a web server"; flow:established,to_server; http.uri; content:"/hermes-results/"; fast_pattern; classtype:policy-violation; sid:3806012; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family Hermes;)
