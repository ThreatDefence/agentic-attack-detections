# Agentic attack detections by ThreatDefence: Strix
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3805001-3805499. DNS and TLS SNI rules work on encrypted traffic.

# --- Strix telemetry, on by default on every scan ---
alert dns $HOME_NET any -> any any (msg:"TD Strix telemetry DNS query (strix.gateway.scarf.sh)"; dns.query; dotprefix; content:".strix.gateway.scarf.sh"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3805001; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_23, confidence High, malware_family Strix, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Strix telemetry TLS (strix.gateway.scarf.sh)"; flow:established,to_server; tls.sni; dotprefix; content:".strix.gateway.scarf.sh"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3805002; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_23, confidence High, malware_family Strix, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Strix telemetry finding reported"; flow:established,to_server; http.host; dotprefix; content:".strix.gateway.scarf.sh"; endswith; http.uri; content:"/finding_reported/"; startswith; fast_pattern; classtype:policy-violation; sid:3805003; rev:2; metadata:created_at 2026_11_21, updated_at 2026_11_23, confidence High, malware_family Strix, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- The Strix results viewer ---
alert http any any -> any any (msg:"TD Strix results viewer page"; flow:established,to_client; http.response_body; content:"<title>Strix Results</title>"; fast_pattern; classtype:policy-violation; sid:3805010; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Strix, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Strix results viewer agent steering API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/agents/steer"; startswith; fast_pattern; classtype:policy-violation; sid:3805011; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family Strix, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
