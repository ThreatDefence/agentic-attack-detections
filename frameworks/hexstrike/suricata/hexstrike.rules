# Agentic attack detections by ThreatDefence: HexStrike
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3803001-3803499. HTTP rules need cleartext HTTP or decrypted traffic.
# The HexStrike server API on 8888 is plain HTTP, so its rules work without decryption.

# --- Requests that reach your targets ---
alert http any any -> any any (msg:"TD HexStrike HTTP framework user agent"; flow:established,to_server; http.user_agent; content:"HexStrike-HTTP-Framework/"; fast_pattern; classtype:web-application-attack; sid:3803001; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family HexStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD HexStrike browser agent user agent"; flow:established,to_server; http.user_agent; content:"HexStrike-BrowserAgent/"; fast_pattern; classtype:web-application-attack; sid:3803002; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family HexStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD HexStrike generated exploit user agent"; flow:established,to_server; http.user_agent; content:"Mozilla/5.0 (Compatible Exploit)"; fast_pattern; classtype:web-application-attack; sid:3803003; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family HexStrike, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD HexStrike XSS reflection probe"; flow:established,to_server; http.uri; content:"hexstrikeXSSTest123"; fast_pattern; classtype:web-application-attack; sid:3803004; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family HexStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)

# --- The HexStrike server API (exposed server, or an MCP client driving one) ---
alert http any any -> any 8888 (msg:"TD HexStrike shell command API request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/command"; startswith; fast_pattern; classtype:attempted-admin; sid:3803010; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family HexStrike, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command_and_Scripting_Interpreter, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any 8888 (msg:"TD HexStrike tool API request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/tools/"; startswith; fast_pattern; classtype:attempted-admin; sid:3803011; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family HexStrike, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
