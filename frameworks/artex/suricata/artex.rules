# Agentic attack detections by ThreatDefence (ARTEX)
# https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
# Suricata 7 and 8. SID range 3800001-3800199. Indicator-based IP rules live in artex-ip.rules (generated).
# HTTP rules need cleartext HTTP or TLS decryption. TLS SNI and DNS rules work on encrypted traffic.

# --- User agents that name ARTEX (requests in either direction: inbound attacks or a host running ARTEX) ---
alert http any any -> any any (msg:"TD ARTEX user agent artex-<role>/1.0"; flow:established,to_server; http.user_agent; content:"artex-"; nocase; fast_pattern; pcre:"/artex-(readonly|pentest|audit|verify|spawn|enrich)\//i"; classtype:web-application-attack; sid:3800001; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent ARTEX-worker"; flow:established,to_server; http.user_agent; content:"ARTEX-worker/"; fast_pattern; classtype:web-application-attack; sid:3800002; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent ARTeX"; flow:established,to_server; http.user_agent; content:"ARTeX"; fast_pattern; classtype:web-application-attack; sid:3800003; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent canary"; flow:established,to_server; http.user_agent; content:"artex-i21861-canary"; fast_pattern; classtype:web-application-attack; sid:3800004; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent Mozilla/5.0 (ARTEX)"; flow:established,to_server; http.user_agent; content:"Mozilla/5.0 (ARTEX)"; fast_pattern; classtype:web-application-attack; sid:3800005; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent ArtEx variant"; flow:established,to_server; http.user_agent; content:"ArtEx"; fast_pattern; pcre:"/ArtEx(Verify)?\/1\.0/"; classtype:web-application-attack; sid:3800006; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX ScopeWeaver renamed build user agent"; flow:established,to_server; http.user_agent; content:"scopeweaver"; nocase; fast_pattern; classtype:web-application-attack; sid:3800007; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX spa-api-recon user agent"; flow:established,to_server; http.user_agent; content:"spa-api-recon"; fast_pattern; classtype:web-application-attack; sid:3800008; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX user agent artex-agent or artex-judge-<run>"; flow:established,to_server; http.user_agent; content:"artex-"; nocase; fast_pattern; pcre:"/(^|[^a-z0-9])artex-(agent([^a-z0-9]|$)|judge-)/i"; classtype:web-application-attack; sid:3800009; rev:1; metadata:created_at 2026_11_22, confidence High, malware_family ARTEX;)

# --- Probe artifacts in requests ---
alert http any any -> $HTTP_SERVERS any (msg:"TD ARTEX placeholder probe path"; flow:established,to_server; http.uri; content:"zzz-nonexistent-xyz123"; fast_pattern; classtype:web-application-attack; sid:3800020; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX placeholder object name in S3 or storage probe"; flow:established,to_server; http.uri; content:"zzz_nonexistent_abc.txt"; fast_pattern; classtype:web-application-attack; sid:3800021; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> $HTTP_SERVERS any (msg:"TD ARTEX OAuth callback probe"; flow:established,to_server; http.uri; content:"code=AAAA&state=notvalidb64!!"; fast_pattern; classtype:web-application-attack; sid:3800022; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
# The header is {"alg":"none"} with or without "typ", {"typ":"JWT","alg":"none"}, or the None and NONE spellings some libraries accept.
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in URI"; flow:established,to_server; http.uri; content:"eyJhbGciOiJub25lI"; fast_pattern; classtype:web-application-attack; sid:3800023; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in URI (typ first)"; flow:established,to_server; http.uri; content:"eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lI"; fast_pattern; classtype:web-application-attack; sid:3800030; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in URI (None or NONE)"; flow:established,to_server; http.uri; content:"eyJhbGciOiJO"; fast_pattern; pcre:"/eyJhbGciOiJO(b25l|T05F)I/"; classtype:web-application-attack; sid:3800032; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in Authorization header"; flow:established,to_server; http.header; content:"Authorization|3a| "; nocase; content:"eyJhbGciOiJub25lI"; distance:0; fast_pattern; classtype:web-application-attack; sid:3800024; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in Authorization header (typ first)"; flow:established,to_server; http.header; content:"Authorization|3a| "; nocase; content:"eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lI"; distance:0; fast_pattern; classtype:web-application-attack; sid:3800031; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Unsigned alg none JWT in Authorization header (None or NONE)"; flow:established,to_server; http.header; content:"Authorization|3a| "; nocase; content:"eyJhbGciOiJO"; distance:0; fast_pattern; pcre:"/eyJhbGciOiJO(b25l|T05F)I/"; classtype:web-application-attack; sid:3800033; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium;)
alert http any any -> any any (msg:"TD ARTEX X-ARTX-KEY request header"; flow:established,to_server; http.header_names; content:"|0d 0a|X-ARTX-KEY|0d 0a|"; nocase; fast_pattern; classtype:web-application-attack; sid:3800025; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX probe marker in request"; flow:established,to_server; http.uri; content:"ARTEX"; nocase; fast_pattern; pcre:"/(ARTEX_WRITE_PROBE|artex_control_marker_zz9q|ARTEX-PROBE-|artex-probe-)/i"; classtype:web-application-attack; sid:3800026; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX persistence marker ARTX_PERSIST_OK in request"; flow:established,to_server; http.uri; content:"ARTX_PERSIST_OK"; nocase; fast_pattern; classtype:web-application-attack; sid:3800027; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium, malware_family ARTEX;)

# --- ARTEX consoles (attack surface checks and hosts on your network running ARTEX) ---
alert http any any -> any any (msg:"TD ARTEX console page served"; flow:established,to_client; http.response_body; content:"<title>ARTEX"; fast_pattern; content:"_next/static"; classtype:policy-violation; sid:3800040; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX renamed console page served (ScopeWeaver)"; flow:established,to_client; http.response_body; content:"<title>ScopeWeaver"; fast_pattern; pcre:"/<title>ScopeWeaver[ :\-<]/"; content:"_next/static"; classtype:policy-violation; sid:3800041; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX renamed console page served (LUCK)"; flow:established,to_client; http.response_body; content:"<title>LUCK"; fast_pattern; pcre:"/<title>LUCK[ :\-<]/"; content:"_next/static"; classtype:policy-violation; sid:3800043; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium, malware_family ARTEX;)
# Forks rename the product and swap the icon, but the title keeps its ending (source-code-signals.md:45). The stock
# ARTEX and ScopeWeaver titles are left out: 3800040 and 3800041 already alert on them.
alert http any any -> any any (msg:"TD ARTEX renamed console page served (title ending)"; flow:established,to_client; http.response_body; content:"Autonomous Penetration Testing Console"; nocase; fast_pattern; content:"_next/static"; content:!"<title>ARTEX"; content:!"<title>ScopeWeaver"; classtype:policy-violation; sid:3800081; rev:2; metadata:created_at 2026_11_22, updated_at 2026_11_25, confidence Medium, malware_family ARTEX;)
# Most renamed consoles (AntiFox, 渗透工作台, artex-mx and others in exposure/consoles.csv) keep the Chinese ending, and a few the Korean one.
alert http any any -> any any (msg:"TD ARTEX renamed console page served (Chinese title ending)"; flow:established,to_client; http.response_body; content:"|e8 87 aa e4 b8 bb e6 b8 97 e9 80 8f e6 b5 8b e8 af 95 e6 8e a7 e5 88 b6 e5 8f b0|"; fast_pattern; content:"_next/static"; content:!"<title>ARTEX"; content:!"<title>ScopeWeaver"; classtype:policy-violation; sid:3800082; rev:1; metadata:created_at 2026_11_25, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX renamed console page served (Korean title ending)"; flow:established,to_client; http.response_body; content:"|ec 9e 90 ec 9c a8 20 ec b9 a8 ed 88 ac 20 ed 85 8c ec 8a a4 ed 8a b8 20 ec bd 98 ec 86 94|"; fast_pattern; content:"_next/static"; content:!"<title>ARTEX"; content:!"<title>ScopeWeaver"; classtype:policy-violation; sid:3800083; rev:1; metadata:created_at 2026_11_25, confidence Medium, malware_family ARTEX;)
alert http any any -> any any (msg:"TD ARTEX Basic auth realm"; flow:established,to_client; http.header; content:"realm=|22|ARTEX|22|"; nocase; fast_pattern; classtype:policy-violation; sid:3800042; rev:1; metadata:created_at 2026_11_20, confidence Medium, malware_family ARTEX;)

# --- Command and control and callback infrastructure (DNS and TLS, works on encrypted traffic) ---
alert dns any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain lookup, ARTEX campaign (nginxmysql.com)"; dns.query; dotprefix; content:".nginxmysql.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800060; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family BLOODALCHEMY;)
alert dns any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain lookup, ARTEX campaign (sqlserver-sqlite.com)"; dns.query; dotprefix; content:".sqlserver-sqlite.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800070; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family BLOODALCHEMY;)
alert dns any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain lookup, ARTEX campaign (ddduuuppp.com)"; dns.query; dotprefix; content:".ddduuuppp.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800071; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family BLOODALCHEMY;)
alert tls any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain in TLS SNI, ARTEX campaign (nginxmysql.com)"; flow:established,to_server; tls.sni; dotprefix; content:".nginxmysql.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800061; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family BLOODALCHEMY;)
alert tls any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain in TLS SNI, ARTEX campaign (sqlserver-sqlite.com)"; flow:established,to_server; tls.sni; dotprefix; content:".sqlserver-sqlite.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800072; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family BLOODALCHEMY;)
alert tls any any -> any any (msg:"TD VAPOR PANDA BLOODALCHEMY C2 domain in TLS SNI, ARTEX campaign (ddduuuppp.com)"; flow:established,to_server; tls.sni; dotprefix; content:".ddduuuppp.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800073; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family BLOODALCHEMY;)
alert dns $HOME_NET any -> any any (msg:"TD Request collection service lookup from a server (webhook.site)"; dns.query; dotprefix; content:".webhook.site"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3800062; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Low;)
alert dns $HOME_NET any -> any any (msg:"TD DNS callback service lookup with artx label (dnslog.cn)"; dns.query; content:"artx"; nocase; content:".dnslog.cn"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800063; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium, malware_family ARTEX;)
alert dns $HOME_NET any -> any any (msg:"TD Community-reported ARTEX infrastructure domain lookup (artex.lol)"; dns.query; dotprefix; content:".artex.lol"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800064; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Low, malware_family ARTEX;)
alert dns $HOME_NET any -> any any (msg:"TD Community-reported ARTEX infrastructure domain lookup (artex.tokena2b.top)"; dns.query; dotprefix; content:".artex.tokena2b.top"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800074; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Low, malware_family ARTEX;)
alert dns $HOME_NET any -> any any (msg:"TD Community-reported ARTEX infrastructure domain lookup (artex.ok7777.eu.cc)"; dns.query; dotprefix; content:".artex.ok7777.eu.cc"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800075; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Low, malware_family ARTEX;)
alert dns $HOME_NET any -> any any (msg:"TD Community-reported ARTEX infrastructure domain lookup (artex.noog2infra.site)"; dns.query; dotprefix; content:".artex.noog2infra.site"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800076; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Low, malware_family ARTEX;)

# --- Payload hosts active in ARTEX operator toolkits (ThreatDefence, November 20, 2026; vietnam852 also reported by Fortinet) ---
alert dns $HOME_NET any -> any any (msg:"TD ARTEX toolkit payload host lookup (vietnam852.com)"; dns.query; dotprefix; content:".vietnam852.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800065; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family Gh0stRAT;)
alert dns $HOME_NET any -> any any (msg:"TD ARTEX toolkit payload host lookup (zhzy999.net)"; dns.query; dotprefix; content:".zhzy999.net"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800077; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family Gh0stRAT;)
alert dns $HOME_NET any -> any any (msg:"TD ARTEX toolkit payload host lookup (jiancai008.com)"; dns.query; dotprefix; content:".jiancai008.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800078; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family Gh0stRAT;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD ARTEX toolkit payload download (vietnam852.com)"; flow:established,to_server; http.host; dotprefix; content:".vietnam852.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800066; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family Gh0stRAT;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD ARTEX toolkit payload download (zhzy999.net)"; flow:established,to_server; http.host; dotprefix; content:".zhzy999.net"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800079; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family Gh0stRAT;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD ARTEX toolkit payload download (jiancai008.com)"; flow:established,to_server; http.host; dotprefix; content:".jiancai008.com"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3800080; rev:1; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence High, malware_family Gh0stRAT;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Fake Windows system binary or miner driver downloaded from a /test/ path"; flow:established,to_server; http.uri; content:"/test/"; fast_pattern; pcre:"/\/test\/(smss\.exe|winlogon\.exe|WinRing0x64\.sys|MicrosoftEdgeUpdate\.exe|dllhost\.exe|sihost\.exe)(\?|$)/i"; classtype:trojan-activity; sid:3800067; rev:2; metadata:created_at 2026_11_20, updated_at 2026_11_22, confidence Medium, malware_family Gh0stRAT;)
# SID 3800068 retired in 2.6.2: it looked for the C2 host name inside the TCP stream, which Gh0st RAT never sends. The DNS rule 3800065 and the address rules cover that host.
